# Generation model served by Ollama. Pull it first: ollama pull llama3.2:3b
# Larger and sharper if you have the RAM: llama3.1:8b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model, downloaded from Hugging Face on first run.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Retrieval tuning.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
MAX_UPLOAD_MB=25

# Server.
SERVER_HOST=127.0.0.1
SERVER_PORT=7860
LOG_LEVEL=INFO
